# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_secret

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=answering_service
DB_USER=postgres
DB_PASSWORD=your_db_password

# Asterisk ARI
ARI_HOST=localhost
ARI_PORT=8088
ARI_USER=asterisk
ARI_PASSWORD=your_ari_password
ARI_APP=answering-service

# SMTP (Email Delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Answering Service <notifications@example.com>"

# SMS Delivery — WebEx Interact (preferred) OR Twilio (fallback)
# Set WEBEX_INTERACT_API_KEY to route SMS through WebEx Interact instead of Twilio.
# Create an API project at https://app.webexinteract.com → Developers to get the key.
# WEBEX_INTERACT_SENDER_ID is the Sender ID configured in your WebEx Interact account.
WEBEX_INTERACT_API_KEY=
WEBEX_INTERACT_SENDER_ID=

# Twilio (fallback SMS + WhatsApp — used when WEBEX_INTERACT_API_KEY is not set)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+441234567890
TWILIO_WHATSAPP_FROM=whatsapp:+441234567890

# Webhook Delivery
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_RETRY_ATTEMPTS=3
