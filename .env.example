# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_secret

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=answering_service
DB_USER=postgres
DB_PASSWORD=your_db_password

# Asterisk ARI
ARI_HOST=localhost
ARI_PORT=8088
ARI_USER=asterisk
ARI_PASSWORD=your_ari_password
ARI_APP=answering-service

# SMTP (Email Delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Answering Service <notifications@example.com>"

# Webhook Delivery
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_RETRY_ATTEMPTS=3
